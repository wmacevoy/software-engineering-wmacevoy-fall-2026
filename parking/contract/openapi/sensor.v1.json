{
  "openapi": "3.1.0",
  "info": {
    "title": "Parking sensor",
    "version": "1.0.0",
    "description": "The API one sensor serves. This document is the agreement that lets the sensor and the collector be built by different people without talking (T-4). Authorization is role-based and OpenAPI cannot express that well, so each operation names the roles from the matrix in REQUIREMENTS.md section A; the matrix is authoritative."
  },
  "servers": [{ "url": "http://sensor:8080" }],
  "components": {
    "securitySchemes": {
      "bearer": { "type": "http", "scheme": "bearer", "bearerFormat": "JWT" }
    },
    "responses": {
      "Error": {
        "description": "See error.v1.json. Retryability is in the body, not inferred from this status (V-6).",
        "content": { "application/json": { "schema": { "$ref": "../schemas/error.v1.json" } } }
      }
    }
  },
  "security": [{ "bearer": [] }],
  "paths": {
    "/health": {
      "get": {
        "summary": "Proof of life, clock state, supported versions, firmware",
        "description": "Deliberately unversioned: this is the discovery endpoint, and versioning it creates a bootstrap problem. Roles: admin, ops, collector. Control-plane fields such as `mode` are omitted for the collector (A-2).",
        "responses": {
          "200": {
            "description": "ok",
            "content": { "application/json": { "schema": { "$ref": "../schemas/health.v1.json" } } }
          },
          "401": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/v1/reading": {
      "get": {
        "summary": "Current count",
        "description": "Roles: admin, ops, collector. Signed per S-8. A 200 here does not mean the data is current — see age_ms (S-3) and the stuck fault mode.",
        "parameters": [
          {
            "name": "X-Trace-Id",
            "in": "header",
            "required": false,
            "schema": { "type": "string" },
            "description": "L-2. Generated by the collector per poll and echoed into the sensor's own log records, so one query returns both sides of the exchange."
          }
        ],
        "responses": {
          "200": {
            "description": "ok",
            "content": { "application/json": { "schema": { "$ref": "../schemas/reading.v1.json" } } }
          },
          "401": { "$ref": "#/components/responses/Error" },
          "503": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/v1/control/state": {
      "get": {
        "summary": "Current fault mode and script position",
        "description": "Roles: admin, ops. Explicitly NOT the collector (A-2) — if the consumer of the data can also read and change the fault state, fault injection stops being a fault.",
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["mode"],
                  "properties": {
                    "mode": { "enum": ["ok", "slow", "down", "stuck", "wrong", "flapping", "skewed"] },
                    "script_index": { "type": ["integer", "null"] },
                    "script_length": { "type": ["integer", "null"] }
                  }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Error" },
          "403": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/v1/control/mode": {
      "post": {
        "summary": "Induce or clear a fault",
        "description": "Roles: admin only. F-1: settable while the system runs, which is what lets an integration test drive a fault instead of waiting for one (T-2).",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["mode"],
                "properties": {
                  "mode": { "enum": ["ok", "slow", "down", "stuck", "wrong", "flapping", "skewed"] },
                  "delay_ms": { "type": "integer", "minimum": 0, "description": "slow mode; must exceed the collector timeout to be meaningful" },
                  "flavor": { "enum": ["refuse", "hang"], "description": "down mode. F-3: they fail differently in a client — one returns at once, the other only ends at a timeout the caller had to have set." },
                  "offset_ms": { "type": "integer", "description": "skewed mode" }
                }
              }
            }
          }
        },
        "responses": {
          "204": { "description": "applied" },
          "400": { "$ref": "#/components/responses/Error" },
          "401": { "$ref": "#/components/responses/Error" },
          "403": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/v1/control/script": {
      "post": {
        "summary": "Load a deterministic occupancy sequence",
        "description": "Roles: admin only. T-1: an explicit step list, never unseeded randomness, so tests can assert exact values. Flaky tests teach that flaky tests are normal.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["steps"],
                "properties": {
                  "steps": { "type": "array", "items": { "type": "integer" }, "minItems": 1 },
                  "loop": { "type": "boolean", "default": true },
                  "interval_ms": { "type": "integer", "minimum": 100 }
                }
              }
            }
          }
        },
        "responses": {
          "204": { "description": "loaded" },
          "400": { "$ref": "#/components/responses/Error" },
          "401": { "$ref": "#/components/responses/Error" },
          "403": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/v1/control/firmware": {
      "post": {
        "summary": "Offer a signed firmware package",
        "description": "Roles: admin only. G-1: admins push; sensors never fetch. Refusals are checked in order — signature, artifact hash, target, version floor, min_version, expiry — and each produces its own audit record (G-7).",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": ["manifest", "manifest_sig", "artifact"],
                "properties": {
                  "manifest": { "$ref": "../schemas/firmware-manifest.v1.json" },
                  "manifest_sig": { "type": "string" },
                  "artifact": { "type": "string", "format": "binary" }
                }
              }
            }
          }
        },
        "responses": {
          "202": { "description": "accepted; installing to the inactive slot. Not done until healthy (G-5)." },
          "401": { "$ref": "#/components/responses/Error" },
          "403": { "$ref": "#/components/responses/Error" },
          "409": { "description": "refused: downgrade_refused, target_mismatch, or manifest_expired", "$ref": "#/components/responses/Error" },
          "422": { "description": "refused: signature_invalid", "$ref": "#/components/responses/Error" }
        }
      }
    }
  }
}
